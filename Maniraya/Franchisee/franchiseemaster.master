<%@ Master Language="C#" AutoEventWireup="true" CodeFile="franchiseemaster.master.cs" Inherits="franchiseemaster" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= clsUtility.ProjectName %></title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="../bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="../bower_components/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="../bower_components/Ionicons/css/ionicons.min.css">
    <link rel="stylesheet" href="../dist/css/AdminLTE.min.css">
    <link rel="stylesheet" href="../dist/css/skins/_all-skins.min.css">
    <link href="http://fonts.googleapis.com/css?family=Lato:100italic,100,300italic,300,400italic,400,700italic,700,900italic,900" rel="stylesheet" type="text/css">
    <link href="../sarah/assets/css/sarah.css" rel="stylesheet">
    <link href="../sarah/assets/css/essentials.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="../myassets/assets/css/maniraya-loader.css?v=1" />
    <link rel="stylesheet" href="assets/css/franchisee-layout.css?v=3" />
    <link rel="stylesheet" href="assets/css/franchisee-theme.css?v=12" />
    <link rel="stylesheet" href="assets/css/franchisee-overrides.css?v=1" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="franchisee-app">
    <form id="form1" runat="server">
        <div id="adminSidebarOverlay" class="admin-sidebar-overlay"></div>
        <div class="admin-app-shell">
            <aside class="admin-sidebar" id="adminSidebar">
                <div class="admin-sidebar-brand">
                    <a href="Dashboard.aspx">
                        <img src="../user/img/logo.png" alt="" />
                    </a>
                </div>
                <div class="admin-sidebar-user">
                    <img id="dvUserImage3" runat="server" src="img/default.png" alt="" />
                    <div>
                        <span class="admin-sidebar-user-label">Logged in as</span>
                        <asp:Label ID="LblMainId" runat="server" CssClass="admin-sidebar-user-name" Text=""></asp:Label>
                    </div>
                </div>
                <nav class="admin-sidebar-body">
                    <div class="admin-sidebar-nav-head">
                        <div class="admin-sidebar-nav-head-text">
                            <span class="admin-sidebar-nav-eyebrow">Browse</span>
                            <strong>Navigation</strong>
                        </div>
                        <span class="admin-sidebar-nav-chip">Franchisee</span>
                    </div>
                    <div class="admin-sidebar-menu-panel">
                        <ul class="admin-side-menu">
                            <li class="admin-side-section">Main</li>
                            <li><a href="Dashboard.aspx" class="admin-side-link"><i class="fa fa-tachometer admin-side-icon"></i> Dashboard</a></li>

                            <li class="admin-side-section">Modules</li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-user admin-side-icon"></i> My Profile <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="UserProfile.aspx">View Profile</a></li>
                                    <li><a href="UserEdit.aspx">Edit Profile</a></li>
                                    <li><a href="requestToChangeNumber.aspx">Request To Change No.</a></li>
                                    <li><a href="UserBankDetail.aspx">Bank Detail</a></li>
                                    <li><a href="PhotoUpload.aspx">Photo Upload</a></li>
                                    <li><a href="CHangePassword.aspx">Change Password</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-id-card-o admin-side-icon"></i> KYC Menu <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="PanCardImage.aspx">Pan Card</a></li>
                                    <li><a href="AddressProof.aspx">Address Proof / Aadhar</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-shopping-cart admin-side-icon"></i> Own Purchase <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="FranchiseeAddSTock.aspx">Franchise Add Stock</a></li>
                                    <li><a href="FranchiseePurchaseDetailFV.aspx">Add Stock Report</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-wrench admin-side-icon"></i> Tools <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="UserDownload.aspx">Download</a></li>
                                    <li><a href="BankDetail.aspx">Company Bank Details</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-bar-chart admin-side-icon"></i> Reports <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="account_Ledger.aspx">Account Ledger</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                    <div class="admin-sidebar-footer">
                        <a href="logout.aspx" class="admin-sidebar-logout">
                            <i class="fa fa-sign-out"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </nav>
            </aside>
            <div class="admin-main">
                <header class="admin-topbar">
                    <button type="button" class="admin-sidebar-toggle" aria-label="Toggle menu">
                        <i class="fa fa-bars"></i>
                    </button>
                    <div class="admin-topbar-intro hidden-xs">
                        <span class="admin-topbar-eyebrow">Franchisee Panel</span>
                    </div>
                    <div class="admin-topbar-spacer"></div>
                    <div class="admin-topbar-actions">
                        <button type="button" id="adminFullscreenBtn" class="admin-topbar-icon-btn" title="Fullscreen" aria-label="Enter fullscreen">
                            <i class="fa fa-expand"></i>
                        </button>
                        <div class="dropdown admin-topbar-user">
                            <a href="#" class="admin-user-trigger dropdown-toggle" data-toggle="dropdown" aria-label="User menu">
                                <span class="admin-user-avatar">
                                    <img id="dvUserImage1" runat="server" src="img/default.png" alt="" />
                                    <span class="admin-user-status"></span>
                                </span>
                                <span class="admin-user-meta hidden-xs">
                                    <span class="admin-user-name">
                                        <asp:Label ID="LblUsernameSideMenu" Font-Bold="true" runat="server" Text=""></asp:Label>
                                    </span>
                                    <span class="admin-user-role">
                                        <asp:Label ID="LblUserRole" runat="server" Text="Franchisee"></asp:Label>
                                    </span>
                                </span>
                                <i class="fa fa-chevron-down admin-user-chevron hidden-xs"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-right admin-user-menu">
                                <li class="admin-user-menu-head">
                                    <span class="admin-user-menu-avatar">
                                        <img id="dvUserImageMenu" runat="server" src="img/default.png" alt="" />
                                    </span>
                                    <span class="admin-user-menu-info">
                                        <strong><asp:Label ID="LblUserMenuName" runat="server" Text=""></asp:Label></strong>
                                        <small><asp:Label ID="LblUserMenuRole" runat="server" Text="Franchisee"></asp:Label></small>
                                    </span>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="UserProfile.aspx" class="admin-user-menu-link">
                                        <span class="admin-user-menu-icon is-profile"><i class="fa fa-user"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>My Profile</strong>
                                            <small>View account</small>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="CHangePassword.aspx" class="admin-user-menu-link">
                                        <span class="admin-user-menu-icon is-password"><i class="fa fa-key"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>Change Password</strong>
                                            <small>Update security</small>
                                        </span>
                                    </a>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="logout.aspx" class="admin-user-menu-link is-logout">
                                        <span class="admin-user-menu-icon is-logout"><i class="fa fa-sign-out"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>Logout</strong>
                                            <small>Sign out safely</small>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <div class="admin-content-wrapper content-wrapper">
                    <section class="admin-page-header-slot">
                    
                    <asp:ContentPlaceHolder ID="contentPageHeading" runat="server">
                        </asp:ContentPlaceHolder>
                   
                        
                    </section>
                    <section class="content">
                        <asp:ContentPlaceHolder ID="contentpageData" runat="server"></asp:ContentPlaceHolder>
                    </section>
                </div>
                <footer class="admin-footer main-footer fr-portal-footer">
                    <div class="fr-footer-inner">
                        <div class="fr-footer-left">
                            <span class="fr-footer-brand"><i class="fa fa-building-o" aria-hidden="true"></i> <%= clsUtility.ProjectName %></span>
                            <span class="fr-footer-copy">Copyright &copy; <%= clsUtility.Session %> All rights reserved.</span>
                        </div>
                        <div class="fr-footer-right">
                            <span class="fr-footer-chip">Franchisee Portal</span>
                            <span class="fr-footer-version">v2.4.0</span>
                        </div>
                    </div>
                </footer>
            </div>
        </div>

        <script type="text/javascript" src="../sarah/assets/plugins/jquery/jquery-2.1.4.min.js"></script>
        <script type="text/javascript">var plugin_path = 'assets/plugins/';</script>
        <script type="text/javascript" src="../sarah/assets/js/sarah.js"></script>
        <script type="text/javascript" src="../sarah/assets/js/app.js"></script>
        <script src="../bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
        <script src="../bower_components/jquery-slimscroll/jquery.slimscroll.min.js"></script>
        <script src="../bower_components/fastclick/lib/fastclick.js"></script>
        <script src="../dist/js/adminlte.min.js"></script>
        <script src="../myassets/assets/js/maniraya-loader.js?v=1"></script>
        <script src="../admin/assets/js/admin-sidebar.js?v=2"></script>
        <script src="../admin/assets/js/admin-header-enhance.js?v=4"></script>
        <script src="../admin/assets/js/admin-topbar.js?v=1"></script>
        <script src="../admin/assets/js/admin-modal.js?v=5"></script>
        <asp:ContentPlaceHolder ID="contentScript" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
