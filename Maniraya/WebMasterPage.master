    <div class="header-bottom-row">
        <div class="container header-bottom-wrap">
            <nav class="header-menu" aria-label="Primary menu">
                <ul class="header-menu-list">
                    <li class="menu-item"><a class="menu-link active" href="index.aspx">Home</a></li>
                    <li class="menu-item has-mega">
                        <a class="menu-link" href="index.aspx#products" data-menu-toggle="mega" aria-expanded="false">
                            Shop <span class="menu-arrow" aria-hidden="true"></span>
                        </a>
                        <div class="mega-menu">
                            <asp:Repeater ID="rptShopCategories" runat="server">
                                <HeaderTemplate>
                                    <div class="mega-col">
                                        <h4>Categories</h4>
                                </HeaderTemplate>
                                <ItemTemplate>
                                    <a href='<%# "products.aspx?category=" + Eval("CategoryId") %>'><%# Eval("CategoryName") %></a>
                                </ItemTemplate>
                                <FooterTemplate>
                                        <a class="mega-view-all" href="categories.aspx">View All Categories</a>
                                    </div>
                                </FooterTemplate>
                            </asp:Repeater>
                            <div class="mega-promo">
                                <p>Special Offer</p>
                                <h5>Get extra 20% off with code</h5>
                                <strong>MPremium</strong>
                                <a href="index.aspx#products">Shop Deals</a>
                            </div>
                        </div>
                    </li>
                    <li class="menu-item">
                        <a class="menu-link" href="index.aspx#products">Deals <span class="menu-badge">Hot</span></a>
                    </li>
                    <li class="menu-item"><a class="menu-link" href="index.aspx#about">About</a></li>
                    <li class="menu-item"><a class="menu-link" href="FAQ.aspx">FAQ</a></li>
                    <li class="menu-item"><a class="menu-link" href="Contact.aspx">Contact</a></li>
                    <li class="menu-item has-dropdown">
