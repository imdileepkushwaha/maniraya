                        </div>
                    </li>
                    <li class="menu-item has-dropdown" id="liMenuLogin" runat="server">
                        <a class="menu-link" href="#" data-menu-toggle="dropdown" aria-expanded="false">
                            Login <span class="menu-arrow" aria-hidden="true"></span>
                        </a>
                        <div class="dropdown-panel">
                            <a href="Login.aspx">User Login</a>
                            <a href="admin/index.aspx">Admin Login</a>
                            <a href="Franchisee/index.aspx">Franchisee Login</a>
                        </div>
                    </li>
                    <li class="menu-item" id="liMenuSignup" runat="server"><a class="menu-link" href="signup.aspx">Sign Up</a></li>
                    <li class="menu-item" id="liMenuDashboard" runat="server" visible="false"><a class="menu-link" href="user/dashboard.aspx">Dashboard</a></li>
                    <li class="menu-item" id="liMenuLogout" runat="server" visible="false"><a class="menu-link" href="logout.aspx">Logout</a></li>
                    <li class="menu-item"><a class="menu-link" href="Login.aspx">Order Tracking</a></li>
                </ul>
            </nav>
            <div class="header-bottom-actions">
                <asp:Label ID="lblwallet" runat="server" CssClass="wallet-badge"></asp:Label>
                <asp:Button ID="BtnMyaccount" runat="server" Text="My Account" CssClass="menu-cta-btn" OnClick="BtnMyaccount_Click"/>
            </div>
        </div>
    </div>
</header>
