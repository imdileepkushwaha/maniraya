    <%--<body class="hold-transition skin-blue sidebar-mini" style="background-color: #fff;">--%>
        <body class="admin-app">
    <form id="form1" runat="server">
        <div id="adminSidebarOverlay" class="admin-sidebar-overlay"></div>
        <div class="admin-app-shell">
            <aside class="admin-sidebar" id="adminSidebar">
                <div class="admin-sidebar-brand">
                    <a href="Dashboard.aspx">
                        <span class="brand-text-mpremium">MPremium</span>
                    </a>
                </div>
                <div class="admin-sidebar-user">
                    <img src="img/default.png" alt="" />
                    <div>
                        <span class="admin-sidebar-user-label">Logged in as</span>
                        <asp:Label ID="LblMainId" runat="server" CssClass="admin-sidebar-user-name" Text=""></asp:Label>
                    </div>
                </div>
                <nav class="admin-sidebar-body">
                    <div class="admin-sidebar-nav-head">
                        <div class="admin-sidebar-nav-head-text">
                            <span class="admin-sidebar-nav-eyebrow">Browse</span>
                            <strong>Navigation</strong>
                        </div>
                        <span class="admin-sidebar-nav-chip">Admin</span>
                    </div>
                    <div class="admin-sidebar-menu-panel">
                    <asp:Panel ID="paneladmin2" runat="server">
                        <ul class="admin-side-menu">
                            <li class="admin-side-section">Main</li>
                            <li><a href="Dashboard.aspx" class="admin-side-link"><i class="fa fa-tachometer admin-side-icon"></i> Dashboard</a></li>

                            <li class="admin-side-section">Modules</li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-wrench admin-side-icon"></i> Utility Management <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="CountryAdd.aspx">Add Country</a></li>
                                    <li><a href="StateAdd.aspx">Add State</a></li>
                                    <li><a href="CityAdd.aspx">Add City</a></li>
                                    <li><a href="BankAdd.aspx">Add Bank</a></li>
                                    <li><a href="BankAccountAdd.aspx">Bank Account Add</a></li>
                                    <li><a href="deductioncharge.aspx">Deduction Master</a></li>
                                    <li><a href="NewsAdd.aspx">News Add</a></li>
                                    <li><a href="PlanAdd.aspx">Add Plan</a></li>
                                    <li><a href="PackagePlanMaster.aspx">Package Plan Master</a></li>
                                    <li><a href="MemberLoginPanel.aspx">Direct Member Login</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-building admin-side-icon"></i> Franchisee Master <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="FranchiseetypeMaster.aspx">Franchisee Type Master</a></li>
                                    <li><a href="franchiseeAdd.aspx">Franchisee Add</a></li>
                                    <li><a href="FranchiseeReport.aspx">Franchisee Report</a></li>
                                    <li><a href="FranchiseePurchaseMaster.aspx">Product Purchase</a></li>
                                    <li><a href="FranchiseePurchaseDetail.aspx">Product Purchase Report</a></li>
                                    <li><a href="FranchiseeStockDetail.aspx">Stock Details</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-globe admin-side-icon"></i> Website Management <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="AddSlider.aspx">Add Slider</a></li>
                                    <li><a href="AddGalleryImage.aspx">Add Image Gallery</a></li>
                                    <li><a href="VideosAdd.aspx">Add Video Gallery</a></li>
                                    <li><a href="FAQAdd.aspx">Add FAQ</a></li>
                                    <li><a href="ContactAdd.aspx">Contact Settings</a></li>
                                    <li><a href="PopupAdd.aspx">Add Popup</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-cube admin-side-icon"></i> Product Management <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="CategoryAdd.aspx">Add Category</a></li>
                                    <li><a href="SubcategoryAdd.aspx">Add Sub-Category</a></li>
                                    <li><a href="SizeAdd.aspx">Add Size</a></li>
                                    <li><a href="ColorAdd.aspx">Add Color</a></li>
                                    <li><a href="ProductSizeColorMaster.aspx">Subcategory Setting</a></li>
                                    <li><a href="ProductAdd.aspx">Add Product</a></li>
                                    <li><a href="ProductDetails.aspx">Product Details</a></li>
                                    <li><a href="ChangeProductStatus.aspx">Change Status</a></li>
                                    <li><a href="StockReport.aspx">Stock Report</a></li>
                                    <li><a href="VendorMaster.aspx">Vendor Master</a></li>
                                    <li><a href="VendorPurchaseMaster.aspx">Stock Purchase</a></li>
                                    <li><a href="VendorPurchaseDetail.aspx">Purchase Details</a></li>
                                    <li><a href="MetalPriceMaster.aspx">Add Commodities Price</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-sitemap admin-side-icon"></i> My Network <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="UserAdd.aspx">Add User</a></li>
                                    <li><a href="UserReport.aspx">User Report</a></li>
                                    <li><a href="kycApprovalForUser.aspx">Approve KYC</a></li>
                                    <li><a href="DownlineReport.aspx">Downline Report</a></li>
                                    <li><a href="treeview.aspx">Treeview Report</a></li>
                                </ul>
                            </li>
                            <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-money admin-side-icon"></i> Accounts <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="TransactionReport.aspx">Transaction Report</a></li>
                                    <li><a href="Dailypayoutdetail.aspx">Daily Closing Report</a></li>
                                </ul>
                            </li>

                             <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-cube admin-side-icon"></i> Saving Product <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="SavingProductAdd.aspx">Add Saving Product</a></li>
                                      <li><a href="SavingProductPurchaseReport.aspx">Saving Purchase Report</a></li>
                                    <li><a href="SavingProductAssign.aspx">Assign Saving Product</a></li>
                                    <li><a href="SavingProductStockAdd.aspx">Add Saving Product Stock</a></li>
                                </ul>
                            </li>

                             <li class="admin-side-group">
                                <button type="button" class="admin-side-toggle"><i class="fa fa-cube admin-side-icon"></i> Purchase Management <i class="fa fa-chevron-down admin-side-chevron"></i></button>
                                <ul class="admin-side-submenu">
                                    <li><a href="UserRepurchaseReport.aspx">Approve Purchase</a></li>
                                <li><a href="UserPurchaseDetail.aspx">Purchase Invoice</a></li>
                                    <li><a href="SavingProductOrderDetails.aspx">Saving Purchase Orders</a></li>
                                </ul>
                            </li>

                           
                        </ul>
                    </asp:Panel>
                    <asp:Panel ID="panelsubadmin2" runat="server">
                        <asp:Literal ID="Literal1" runat="server"></asp:Literal>
                    </asp:Panel>
                    </div>
                    <div class="admin-sidebar-footer">
                        <a href="logout.aspx" class="admin-sidebar-logout">
                            <i class="fa fa-sign-out"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </nav>
            </aside>
            <div class="admin-main">
                <header class="admin-topbar">
                    <button type="button" class="admin-sidebar-toggle" aria-label="Toggle menu">
                        <i class="fa fa-bars"></i>
                    </button>
                    <div class="admin-topbar-intro hidden-xs">
                        <span class="admin-topbar-eyebrow">Welcome back</span>
                        <!--<strong class="admin-topbar-greet">
                            <asp:Label ID="LblTopbarGreet" runat="server" Text=""></asp:Label>
                        </strong>-->
                    </div>
                    <div class="admin-topbar-spacer"></div>
                    <div class="admin-topbar-actions">
                        <button type="button" id="adminFullscreenBtn" class="admin-topbar-icon-btn" title="Fullscreen" aria-label="Enter fullscreen">
                            <i class="fa fa-expand"></i>
                        </button>
                        <div class="dropdown admin-topbar-notify">
                            <button type="button" class="admin-topbar-icon-btn dropdown-toggle" data-toggle="dropdown" aria-label="Notifications">
                                <i class="fa fa-bell"></i>
                                <asp:Panel ID="pnlNotifyBadge" runat="server" CssClass="admin-topbar-badge" Visible="false">
                                    <asp:Literal ID="LitNotifyCount" runat="server"></asp:Literal>
                                </asp:Panel>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right admin-notify-dropdown">
                                <div class="admin-notify-dropdown-head">
                                    <strong>Notifications</strong>
                                    <span>Inbox messages</span>
                                </div>
                                <div class="admin-notify-dropdown-body">
                                    <asp:Literal ID="LitNotifyList" runat="server"></asp:Literal>
                                </div>
                                <a href="InboxAdmin.aspx" class="admin-notify-dropdown-foot">
                                    View all messages <i class="fa fa-angle-right"></i>
                                </a>
                            </div>
                        </div>
                        <div class="dropdown admin-topbar-user">
                            <a href="#" class="admin-user-trigger dropdown-toggle" data-toggle="dropdown" aria-label="User menu">
                                <span class="admin-user-avatar">
                                    <img src="img/default.png" alt="" />
                                    <span class="admin-user-status"></span>
                                </span>
                                <span class="admin-user-meta hidden-xs">
                                    <span class="admin-user-name">
                                        <asp:Label ID="LblUsernameSideMenu" Font-Bold="true" runat="server" Text=""></asp:Label>
                                    </span>
                                    <span class="admin-user-role">
                                        <asp:Label ID="LblUserRole" runat="server" Text="Administrator"></asp:Label>
                                    </span>
                                </span>
                                <i class="fa fa-chevron-down admin-user-chevron hidden-xs"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-right admin-user-menu">
                                <li class="admin-user-menu-head">
                                    <span class="admin-user-menu-avatar">
                                        <img src="img/default.png" alt="" />
                                    </span>
                                    <span class="admin-user-menu-info">
                                        <strong><asp:Label ID="LblUserMenuName" runat="server" Text=""></asp:Label></strong>
                                        <small><asp:Label ID="LblUserMenuRole" runat="server" Text="Administrator"></asp:Label></small>
                                    </span>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="Dashboard.aspx" class="admin-user-menu-link">
                                        <span class="admin-user-menu-icon is-profile"><i class="fa fa-user"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>My Profile</strong>
                                            <small>Account overview</small>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="CHangePassword.aspx" class="admin-user-menu-link">
                                        <span class="admin-user-menu-icon is-password"><i class="fa fa-key"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>Change Password</strong>
                                            <small>Update security</small>
                                        </span>
                                    </a>
                                </li>
                                <li class="divider"></li>
                                <li>
                                    <a href="logout.aspx" class="admin-user-menu-link is-logout">
                                        <span class="admin-user-menu-icon is-logout"><i class="fa fa-sign-out"></i></span>
                                        <span class="admin-user-menu-text">
                                            <strong>Logout</strong>
                                            <small>Sign out safely</small>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <div class="admin-content-wrapper content-wrapper">
                    <div class="admin-page-header-slot">
                        <asp:ContentPlaceHolder ID="contentPageHeading" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                    <section class="content">
                        <asp:ContentPlaceHolder ID="contentpageData" runat="server"></asp:ContentPlaceHolder>
                    </section>
                </div>
                <footer class="admin-footer main-footer">
                    <div class="pull-right hidden-xs">
                        <b><%= clsUtility.ProjectName %></b> 2.4.0
                    </div>
                    <strong>Copyright &copy; <%= clsUtility.Session %> <a href="#"><%= clsUtility.ProjectName %></a>.</strong> All rights reserved.
                </footer>
            </div>
        </div>
