        <%--<script src="../bower_components/jquery/dist/jquery.min.js"></script>--%>
        
        
        <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
		<script type="text/javascript" src="../sarah/assets/plugins/jquery/jquery-2.1.4.min.js"></script>
